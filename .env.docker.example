# Configuración del entorno Flask para Docker
FLASK_ENV=production
SECRET_KEY=
DATABASE_URL=mysql+pymysql://qrfarm_user:qrfarm_password@mysql:3306/qr_farm_db

# Configuración de la base de datos MySQL para Docker
DB_HOST=mysql
DB_PORT=3306
DB_NAME=qr_farm_db
DB_USER=qrfarm_user
DB_PASSWORD=qrfarm_password
DB_POOL_SIZE=10

# Configuración JWT
JWT_SECRET_KEY=your_jwt_secret_key_here
JWT_ACCESS_TOKEN_EXPIRES=86400

# Credenciales para el usuario admin (se crean automáticamente al ejecutar Flask)
ADMIN_EMAIL=admin@qrfarm.com
ADMIN_PASSWORD=admin123

# Configuración adicional
DEBUG=False
TESTING=False

# Clave compartida del equipo para seeders cifrados (hex). El lider del equipo la genera y la comparte:
TEAM_KEY=

# Super admin
ROOT_SUPER_ADMIN_EMAIL=superadmin@qrfarm.com
ROOT_SUPER_ADMIN_PASSWORD=
ROOT_SUPER_ADMIN_NOMBRE=Super Administrador QR-Farm