# Configuración del entorno Flask para Docker
FLASK_ENV=production
SECRET_KEY=your_secret_key_here_change_this

# ⚠️  IMPORTANTE: Las variables DB_* están HARDCODEADAS en docker-compose.yml
# MySQL: root/(vacía)/gestion_ganadera - NO se usan las variables DB_* de este archivo

# Configuración JWT
JWT_SECRET_KEY=your_jwt_secret_key_here_change_this
JWT_ACCESS_TOKEN_EXPIRES=86400

# Credenciales para el usuario admin (se crean automáticamente al ejecutar Flask)
ADMIN_EMAIL=admin@qrfarm.com
ADMIN_PASSWORD=admin123

# Configuración adicional
DEBUG=False
TESTING=False

# Clave compartida del equipo para seeders cifrados (hex). El lider del equipo la genera y la comparte:
TEAM_KEY=

# Super admin
ROOT_SUPER_ADMIN_EMAIL=superadmin@qrfarm.com
ROOT_SUPER_ADMIN_PASSWORD=admin999
ROOT_SUPER_ADMIN_NOMBRE=Super Administrador QR-Farm