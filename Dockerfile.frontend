# Dockerfile para el frontend de QR-Farm

# Etapa de build
FROM node:20-alpine AS build-stage

# Establecer directorio de trabajo
WORKDIR /app

# Copiar package.json e instalar dependencias
COPY frontend/package*.json ./
RUN npm install

# Variables de entorno para build (opcionales, con valores por defecto)
# Se pueden pasar como build args desde docker-compose.yml si es necesario
# Valor por defecto: usa localhost:5010 (puerto externo del backend en Docker)
ARG VITE_BACKEND_URL=http://localhost:5010
ENV VITE_BACKEND_URL=$VITE_BACKEND_URL

# NOTA: .env NO se copia en la imagen por seguridad.
# Si se necesitan variables específicas, pasarlas como build args en docker-compose.yml

# Copiar código fuente
COPY frontend/ .

# Build de la aplicación
RUN npm run build

# Etapa de producción con nginx
FROM nginx:stable-alpine AS production-stage

# Copiar configuración de nginx personalizada
COPY --from=build-stage /app/dist /usr/share/nginx/html

# Copiar configuración de nginx
COPY nginx.conf /etc/nginx/nginx.conf

# Exponer puerto
EXPOSE 80

# Comando por defecto
CMD ["nginx", "-g", "daemon off;"]