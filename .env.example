# ============================================================================
# CONFIGURACIÃ“N UNIFICADA PARA DESARROLLO LOCAL Y DOCKER
# ============================================================================
# Este archivo funciona tanto para ejecuciÃ³n local como con Docker Compose
# Lee los comentarios de cada secciÃ³n para configurar segÃºn tu entorno
# ============================================================================

# ----------------------------------------------------------------------------
# ENTORNO FLASK
# ----------------------------------------------------------------------------
# - development: Para desarrollo local (permite valores por defecto de CORS)
# - production: Para Docker (requiere CORS_ORIGINS configurado)
FLASK_ENV=development

# ----------------------------------------------------------------------------
# CLAVES SECRETAS (OBLIGATORIAS - Cambiar en producciÃ³n)
# ----------------------------------------------------------------------------
SECRET_KEY=tu_clave_secreta_aqui_cambiar_esto
JWT_SECRET_KEY=tu_clave_jwt_secreta_aqui_cambiar_esto
JWT_ACCESS_TOKEN_EXPIRES=86400

# Para generar claves seguras, ejecuta:
# python -c "import secrets; print(secrets.token_hex(32))"

# ----------------------------------------------------------------------------
# CONFIGURACIÃ“N DE BASE DE DATOS MYSQL
# ----------------------------------------------------------------------------
# DESARROLLO LOCAL:
#   DB_HOST=localhost
#   DB_PORT=3306
#   DB_USER=tu_usuario_mysql_local
#   DB_PASSWORD=tu_contraseÃ±a_mysql_local
#
# DOCKER:
#   DB_HOST=mysql (nombre del servicio en docker-compose.yml)
#   DB_PORT=3306 (puerto interno del contenedor)
#   DB_USER=root
#   DB_PASSWORD= (vacÃ­o, MySQL en Docker no tiene contraseÃ±a por defecto)
#   NOTA: En Docker, DB_HOST se sobrescribe automÃ¡ticamente a 'mysql' en docker-compose.yml
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestion_ganadera
DB_USER=tu_usuario_mysql_aqui
DB_PASSWORD=tu_contraseÃ±a_mysql_aqui
DB_POOL_SIZE=10

# ----------------------------------------------------------------------------
# CONFIGURACIÃ“N CORS (Backend)
# ----------------------------------------------------------------------------
# DESARROLLO LOCAL:
#   Puede estar vacÃ­o - el backend usa valores por defecto si FLASK_ENV=development
#   O configurar: CORS_ORIGINS=http://localhost:5173,http://localhost:5174
#
# DOCKER (OBLIGATORIO):
#   CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:80
#   Debe incluir el puerto del frontend (5174) y otros orÃ­genes permitidos
CORS_ORIGINS=

# ----------------------------------------------------------------------------
# CONFIGURACIÃ“N DEL FRONTEND (Variables VITE_)
# ----------------------------------------------------------------------------
# DESARROLLO LOCAL:
#   VITE_BACKEND_URL=http://localhost:5000
#   (puerto donde corre el backend Flask localmente)
#
# DOCKER (OBLIGATORIO):
#   VITE_BACKEND_URL=http://localhost:5010
#   (puerto externo mapeado del backend en docker-compose.yml)
VITE_BACKEND_URL=http://localhost:5000

# ----------------------------------------------------------------------------
# CONFIGURACIÃ“N DEL BACKEND (Opcional, para logs y URLs)
# ----------------------------------------------------------------------------
# Solo necesario si quieres personalizar los logs del backend
# Por defecto usa 0.0.0.0:5000
BACKEND_HOST=0.0.0.0
BACKEND_PORT=5000

# ----------------------------------------------------------------------------
# CONFIGURACIÃ“N ADICIONAL
# ----------------------------------------------------------------------------
DEBUG=True
TESTING=False

# ----------------------------------------------------------------------------
# CREDENCIALES DE USUARIOS ADMINISTRADORES
# ----------------------------------------------------------------------------
# Usuario admin (creado automÃ¡ticamente)
ADMIN_EMAIL=admin@qrfarm.com
ADMIN_PASSWORD=contrasena_segura_aqui

# Super administrador (creado automÃ¡ticamente)
ROOT_SUPER_ADMIN_EMAIL=superadmin@qrfarm.com
ROOT_SUPER_ADMIN_PASSWORD=tu_contraseÃ±a_super_admin_aqui_cambiar_esto
ROOT_SUPER_ADMIN_NOMBRE=Super Administrador QR-Farm

# ----------------------------------------------------------------------------
# CONFIGURACIÃ“N ADICIONAL
# ----------------------------------------------------------------------------
# Clave compartida del equipo para seeders cifrados (hex)
TEAM_KEY=
