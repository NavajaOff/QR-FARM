# Configuración para DOCKER
# Este archivo contiene la configuración para ejecutar el proyecto con Docker
# Copia este archivo a .env cuando vayas a trabajar con Docker:
#   copy .env.docker .env

# Entorno Flask
# NOTA: Docker sobrescribe esto a 'production' automáticamente
FLASK_ENV=production
DEBUG=False

# Clave secreta para Flask y sesiones
# IMPORTANTE: Genera una nueva clave para tu entorno
SECRET_KEY=tu_clave_secreta_aqui

# Configuración de base de datos MySQL (DOCKER)
DB_HOST=mysql
DB_PORT=3306
DB_NAME=gestion_ganadera
DB_USER=tusuario_mysql_aqui
DB_PASSWORD=tu_contraseña_root_aqui
DB_POOL_SIZE=10
MYSQL_ROOT_PASSWORD=tu_contraseña_root_aqui
MYSQL_DATABASE=gestion_ganadera
MYSQL_USER=tusuario_mysql_aqui
MYSQL_PASSWORD=tu_contraseña_mysql_aqui

# Configuración JWT
JWT_SECRET_KEY=tu_clave_secreta_aqui
JWT_ACCESS_TOKEN_EXPIRES=86400

# Configuración adicional
TESTING=False
RUN_SEEDERS=False
PORT=5000
BACKEND_PORT=5010
FRONTEND_PORT=5174
FRONTEND_TARGET=production

# Clave compartida del equipo para seeders cifrados (hex)
TEAM_KEY=

# Super administrador
ROOT_SUPER_ADMIN_EMAIL=correo_superadmin_aqui
ROOT_SUPER_ADMIN_PASSWORD=tu_contraseña_segura_aquí
ROOT_SUPER_ADMIN_NOMBRE=Super Administrador QR-Farm

# Configuración del frontend (variables VITE_ para Vite)
# DOCKER: Frontend en puerto 5174, Backend en puerto 5010 (externo)
VITE_BACKEND_URL=http://localhost:5010

# CORS Origins
CORS_ORIGINS=http://localhost:5174,http://localhost:5173,http://localhost:80,http://frontend,http://frontend:80



