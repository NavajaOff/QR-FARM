# Configuración unificada para desarrollo local y Docker
# Este archivo funciona tanto para ejecución local como con Docker Compose

# Entorno Flask (development para local, production para Docker)
FLASK_ENV=development

# Clave secreta para Flask y sesiones
SECRET_KEY=tu_clave_secreta_aqui_cambiar_esto

# Configuración de base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_NAME=gestion_ganadera
DB_USER=tu_usuario_mysql_aqui
DB_PASSWORD=tu_contraseña_mysql_aqui
DB_POOL_SIZE=10

# Configuración JWT
JWT_SECRET_KEY=tu_clave_jwt_secreta_aqui_cambiar_esto
JWT_ACCESS_TOKEN_EXPIRES=86400

# Credenciales para usuario admin (creado automáticamente)
ADMIN_EMAIL=admin@qrfarm.com
ADMIN_PASSWORD=contrasena_segura_aqui

# Configuración adicional
DEBUG=True
TESTING=False

# Clave compartida del equipo para seeders cifrados (hex)
TEAM_KEY=

# Super administrador
ROOT_SUPER_ADMIN_EMAIL=superadmin@qrfarm.com
ROOT_SUPER_ADMIN_PASSWORD=tu_contraseña_super_admin_aqui_cambiar_esto
ROOT_SUPER_ADMIN_NOMBRE=Super Administrador QR-Farm

# Configuración del frontend (variables VITE_ para Vite)
VITE_BACKEND_URL=http://localhost:5000