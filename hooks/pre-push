#!/bin/bash

echo "🔄 Ejecutando hook pre-push: Generando reporte de cobertura..."

# Backend coverage
if pytest --cov=src --cov-report=xml:backend/coverage.xml --cov-report=term; then
    echo "✅ Pruebas de backend ejecutadas exitosamente."
else
    echo "❌ Error en las pruebas de backend. Abortando push."
    exit 1
fi

# Ajustar el source en backend/coverage.xml
if [ -f backend/coverage.xml ]; then
    sed -i '' 's|<source>.*</source>|<source>src</source>|g' backend/coverage.xml
    echo "✅ Archivo backend/coverage.xml ajustado."
else
    echo "❌ Error: No se encontró backend/coverage.xml"
    exit 1
fi

# Frontend coverage
echo "🔄 Generando cobertura de frontend..."
cd frontend
npx vitest --coverage --run || true
echo "✅ Cobertura de frontend generada (o sin tests)."

# Verificar si existe cobertura-frontend.xml generado por Vitest
if [ -f coverage-frontend/cobertura-frontend.xml ]; then
    echo "✅ Archivo cobertura-frontend.xml encontrado."
else
    echo "⚠️  No se encontró cobertura-frontend.xml, creando archivo básico..."
    mkdir -p coverage-frontend
    echo '<?xml version="1.0" ?><coverage version="7.12.0" timestamp="1764376865831" lines-valid="0" lines-covered="0" line-rate="0" branches-covered="0" branches-valid="0" branch-rate="0" complexity="0"><sources><source>src</source></sources><packages></packages></coverage>' > coverage-frontend/cobertura-frontend.xml
fi

# Ajustar el source en frontend/coverage-frontend/cobertura-frontend.xml
if [ -f coverage-frontend/cobertura-frontend.xml ]; then
    sed -i '' 's|<source>.*</source>|<source>src</source>|g' coverage-frontend/cobertura-frontend.xml
    echo "✅ Archivo frontend/coverage-frontend/cobertura-frontend.xml ajustado."
else
    echo "❌ Error: No se pudo crear frontend/coverage-frontend/cobertura-frontend.xml"
    cd ..
    exit 1
fi
cd ..

# Mostrar reportes de cobertura
echo "📊 Reporte de cobertura - Backend:"
cd backend && python -m coverage report
cd ..

echo "📊 Reporte de cobertura - Frontend:"
echo "Archivo de cobertura: frontend/coverage-frontend/cobertura-frontend.xml"
if [ -f frontend/coverage-frontend/cobertura-frontend.xml ]; then
    echo "✅ Archivo de cobertura frontend existe"
else
    echo "❌ Archivo de cobertura frontend no encontrado"
fi

echo "🎉 Hook pre-push completado exitosamente."
exit 0
