#!/bin/bash

echo "🔄 Ejecutando hook pre-push: Generando reporte de cobertura..."

# Backend coverage
if pytest --cov=src --cov-report=xml:backend/coverage.xml --cov-report=term; then
    echo "✅ Pruebas de backend ejecutadas exitosamente."
else
    echo "❌ Error en las pruebas de backend. Abortando push."
    exit 1
fi

# Ajustar el source en backend/coverage.xml
if [ -f backend/coverage.xml ]; then
    sed -i '' 's|<source>.*</source>|<source>src</source>|g' backend/coverage.xml
    echo "✅ Archivo backend/coverage.xml ajustado."
else
    echo "❌ Error: No se encontró backend/coverage.xml"
    exit 1
fi

# Frontend coverage
echo "🔄 Generando cobertura de frontend..."
cd frontend
npx vitest run --coverage || true
echo "✅ Cobertura de frontend generada."

# Verificar que se generó el archivo LCOV
if [ -f coverage/lcov.info ]; then
    echo "✅ Archivo frontend/coverage/lcov.info encontrado."
else
    echo "⚠️  No se encontró coverage/lcov.info, verificando si existe el directorio..."
    if [ ! -d "coverage" ]; then
        echo "Creando directorio coverage..."
        mkdir -p coverage
    fi
    echo "El archivo LCOV se generará en el próximo push si las pruebas pasan."
fi
cd ..

# Mostrar reportes de cobertura
echo "📊 Reporte de cobertura - Backend:"
cd backend && python -m coverage report
cd ..

echo "📊 Reporte de cobertura - Frontend:"
echo "Archivo de cobertura: frontend/coverage-frontend/cobertura-frontend.xml"
if [ -f frontend/coverage-frontend/cobertura-frontend.xml ]; then
    echo "✅ Archivo de cobertura frontend existe"
else
    echo "❌ Archivo de cobertura frontend no encontrado"
fi

echo "🎉 Hook pre-push completado exitosamente."
exit 0
