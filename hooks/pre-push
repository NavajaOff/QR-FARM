#!/bin/bash

echo "🔄 Ejecutando hook pre-push: Generando reporte de cobertura..."

# Backend coverage
if pytest --cov=src --cov-report=xml:backend/coverage.xml --cov-report=term; then
    echo "✅ Pruebas de backend ejecutadas exitosamente."
else
    echo "❌ Error en las pruebas de backend. Abortando push."
    exit 1
fi

# Ajustar el source en backend/coverage.xml
if [ -f backend/coverage.xml ]; then
    sed -i '' 's|<source>.*</source>|<source>src</source>|g' backend/coverage.xml
    echo "✅ Archivo backend/coverage.xml ajustado."
else
    echo "❌ Error: No se encontró backend/coverage.xml"
    exit 1
fi

# Frontend coverage
echo "🔄 Generando cobertura de frontend..."
cd frontend
npx vitest --coverage --run || true
echo "✅ Cobertura de frontend generada (o sin tests)."

# Ajustar el source en frontend/coverage-frontend/coverage.xml
if [ -f coverage-frontend/coverage.xml ]; then
    sed -i '' 's|<source>.*</source>|<source>src</source>|g' coverage-frontend/coverage.xml
    echo "✅ Archivo frontend/coverage-frontend/coverage.xml ajustado."
else
    echo "❌ Error: No se encontró frontend/coverage-frontend/coverage.xml"
    cd ..
    exit 1
fi
cd ..

# Mostrar reportes de cobertura
echo "📊 Reporte de cobertura - Backend:"
cd backend && python -m coverage report
cd ..

echo "📊 Reporte de cobertura - Frontend:"
cd frontend && npx vitest --coverage
cd ..

echo "🎉 Hook pre-push completado exitosamente."
exit 0
